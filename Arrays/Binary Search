public class Arr_Search {

public static int Bin_search(int nums[],int key) {
        int start=0;
        int end=nums.length-1;


        for (int i=0;i<nums.length;i++){
        int mid= (start+end)/2;
        //Compare mid and key 
            if (nums[mid]==key){
                System.out.println("KEY FOUND AT INDEX "+ mid);
                return mid;
            }
            if(nums[mid]>key){
                end=mid-1;
            }
            if (nums[mid]<key){
                start=mid+1;
            }
        }
        return -1;
    }
 public static void main(String[] args) {
        int nums[]={1,3,4,5,6,7,8,9,11,23};
        int key=6;
        Bin_search(nums,key);

}}
